function Y = F_ode(Z,M,n1,n2,N,alpha,sigma,rho,omega,beta,mu,lambda,gamma,tau,delta,k1)
sizes_red=[2,n1,n2+2*(0:N-1)];
V=M-sizes_red*Z;
Y=zeros(N+2,1);

Y(1)=alpha*V^2+rho*V^2*Z(1)-omega*Z(1)-n1*(beta*Z(3)^2*Z(1)+sigma*Z(1)^3)+delta*sum(Z(4:end))+3*(gamma*Z(2));

Y(2)=2*mu*Z(3)+2*k1*Z(2)*Z(3)-gamma*Z(2)-lambda*Z(2)^2;

Y(3)=sigma*Z(1)^3+beta*Z(3)^2*Z(1)-mu*Z(3)-k1*Z(2)*Z(3)-(tau*V^2)*Z(3)+delta*Z(4);

for i=4:N+1
    Y(i)=(tau*V^2)*Z(i-1)-delta*Z(i)-((tau*V^2)*Z(i)-delta*Z(i+1));
end
Y(N+2)=(tau*V^2)*Z(N+1)-delta*Z(N+2);
end
