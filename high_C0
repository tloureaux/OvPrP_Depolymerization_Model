clear all;
clc;

alpha=1e-2;
rho=0.7;
omega=0.1;
sigma=1e-4;
beta=150;
mu=0.01;
lambda=230;
gamma=8;
tau=0.8;
delta=0.8;
k1=250;

%% Parameters

nT=2;
n1=6;
n2=12;
N=100;

sizes=[1,nT,n1,n2+nT*(0:N-1)];
sizes_red=[2,n1,n2+2*(0:N-1)];

%% Phase 1

M=100;

Z0=zeros(N+2,1);

F1=@(t,Z) F_ode(Z,M,n1,n2,N,...
    alpha,sigma,rho,omega,beta,mu,lambda,...
    5,0.1,0.1,10);

[~,Y]=ode23s(F1,[0 300],Z0);

Y=Y';

z0=Y(:,end)/M;
z0(1)=0;
z0(2)=0;

M_agreg=sizes(2:end)*z0;
z0_adim=z0/M_agreg;

% C0 values

C0_values=[6 4 3 2 1 0.5];
colors=lines(length(C0_values));

%% Figures

fig = figure('Position',[50 50 1800 850]);
tl  = tiledlayout(fig,2,4,'TileSpacing','compact','Padding','compact');

ax = gobjects(7,1);
for p = 1:7
    ax(p) = nexttile(tl);
    hold(ax(p),'on');
    grid(ax(p),'on');
end

addLetter = @(a,L) text(a,-0.14,1.08,L,'Units','normalized',...
    'FontSize',16,'FontWeight','bold');

% Mw(t)
title(ax(1),'MOLECULAR WEIGHT M_w(t)');
xlabel(ax(1),'Time'); ylabel(ax(1),'M_w');

% Mw(t) zoom
title(ax(2),'MOLECULAR WEIGHT M_w(t) (zoom)');
xlabel(ax(2),'Time'); ylabel(ax(2),'M_w');

% M(t)
title(ax(3),'MONOMERS M(t)');
xlabel(ax(3),'Time'); ylabel(ax(3),'M');

% W(t)
title(ax(4),'6-MERS W(t)');
xlabel(ax(4),'Time'); ylabel(ax(4),'W');

% T(t)
title(ax(5),'DIMERS T(t)');
xlabel(ax(5),'Time'); ylabel(ax(5),'T');

% S(t)
title(ax(6),'BASES S(t)');
xlabel(ax(6),'Time'); ylabel(ax(6),'S');

% Ei 3D
title(ax(7),'AGGREGATES OF SIZE i E_i, 1 ≤ i ≤ 10');
xlabel(ax(7),'Time'); ylabel(ax(7),'Polymer index i'); zlabel(ax(7),'E_i');
view(ax(7),45,30);

% Loop over C0

hLeg = gobjects(length(C0_values),1);

for k = 1:length(C0_values)

    C0 = C0_values(k);
    Z0 = z0_adim*C0;

    F2 = @(t,Z) F_ode(Z,C0,n1,n2,N,...
        alpha,sigma,rho,omega,...
        beta,mu,lambda,...
        gamma,tau,delta,k1);

    [t,Y_late] = ode15s(F2,[0 500],Z0);
    Y_late = Y_late';

    T  = Y_late(1,:);
    W  = Y_late(2,:);
    S  = Y_late(3,:);
    Ei = Y_late(4:end,:);

    V  = C0 - sizes_red*Y_late;
    M2 = 1 - sizes_red*Y_late/C0 + sizes_red.^2*Y_late/C0;

    c = colors(k,:);

    % Species
    hLeg(k) = plot(ax(1),t,M2,'LineWidth',2,'Color',c);
    plot(ax(2),t,M2, 'LineWidth',2,'Color',c);
    plot(ax(3),t,V,  'LineWidth',2,'Color',c);
    plot(ax(4),t,W,  'LineWidth',2,'Color',c);
    plot(ax(5),t,T,  'LineWidth',2,'Color',c);
    plot(ax(6),t,S,  'LineWidth',2,'Color',c);

    % Ei (i = 1,...,10)
    for i = 1:10
        plot3(ax(7),t,i*ones(size(t)),Ei(i,:),'Color',c,'LineWidth',2);
    end
end

xz = [0 100];
yz = [0 13];
zc = [0.80 0.15 0.15];

xlim(ax(2),xz);
ylim(ax(2),yz);

rectangle(ax(1),'Position',[xz(1) yz(1) diff(xz) diff(yz)],...
    'EdgeColor',zc,'LineWidth',1.5);

rectangle(ax(2),'Position',[xz(1) yz(1) diff(xz) diff(yz)],...
    'EdgeColor',zc,'LineWidth',2,'Clipping','off');

ax(2).YAxisLocation = 'right';

% Connector lines
drawnow;
fp = getpixelposition(fig);
toFig = @(a,x,y) deal( ...
    (getpixelposition(a,true)*[1;0;0;0] + (x-a.XLim(1))/diff(a.XLim)*getpixelposition(a,true)*[0;0;1;0]) / fp(3), ...
    (getpixelposition(a,true)*[0;1;0;0] + (y-a.YLim(1))/diff(a.YLim)*getpixelposition(a,true)*[0;0;0;1]) / fp(4));

[x1t,y1t] = toFig(ax(1),xz(2),yz(2));
[x1b,y1b] = toFig(ax(1),xz(2),yz(1));
[x2t,y2t] = toFig(ax(2),xz(1),yz(2));
[x2b,y2b] = toFig(ax(2),xz(1),yz(1));

annotation(fig,'line',[x1t x2t],[y1t y2t],'Color',zc,'LineStyle','--','LineWidth',1);
annotation(fig,'line',[x1b x2b],[y1b y2b],'Color',zc,'LineStyle','--','LineWidth',1);

addLetter(ax(1),'A');
addLetter(ax(3),'B');
addLetter(ax(4),'C');
addLetter(ax(5),'D');
addLetter(ax(6),'E');
addLetter(ax(7),'F');

legendLabels = compose("C_{0} = %g", C0_values);
lgd = legend(hLeg,legendLabels,'Interpreter','tex');
lgd.Layout.Tile = 8;
