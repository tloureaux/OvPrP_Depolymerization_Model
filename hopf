clc; clear; close all;

%% PARAMETERS
P.alpha=1e-2; P.rho=0.7; P.omega=0.1; P.sigma=1e-4; P.beta=150; P.mu=0.01;
P.lambda=230; P.gamma=8; P.tau=0.8; P.delta=0.8; P.k1=250;
P.nT=2; P.n1=6; P.n2=12; P.N=100;

C0H    = 3.152311;
omegaH = 5.6991;            % Im(lambda) at Hopf
f      = make_formulas(P);
s      = [2, P.n1, P.n2, P.n2 + 2*(1:P.N-1)];
opts   = odeset('RelTol',1e-8,'AbsTol',1e-12);
rng(1);

dC     = [-0.20 -0.10 -0.05 0.03 0.06 0.10 0.15 0.20 0.40 0.80 1.50 2.85];
C0list = C0H + dC;
nL     = numel(C0list);

% Polymerization
M  = 100;
F1 = @(t,Z) F_ode(Z,M,P.n1,P.n2,P.N,P.alpha,P.sigma,P.rho,P.omega,P.beta, ...
                  P.mu,P.lambda,5,0.1,0.1,10);
[~,Y1] = ode23s(F1,[0 300],zeros(P.N+2,1));
z0 = Y1(end,:).'/M;  z0(1:2) = 0;  z0_adim = z0/(s*z0);

ICnames = {'small pert.','large pert.','stage-1 IC'};
nIC  = numel(ICnames);
ampW = nan(nL,nIC);  ampM = nan(nL,nIC);  per = nan(nL,nIC);
gap  = nan(nL,nIC);  drift = nan(nL,nIC);
ReL  = nan(nL,1);    MwEq = nan(nL,1);

fprintf('  C0        dC      Re(lam)   IC            amp(W)      amp(Mw)    period    gap(Mw)    drift\n');
for ic = 1:nL
    C   = C0list(ic);
    Wr  = find_equilibria(C, f, 40000);
    Zeq = build_eq(Wr(end), f, P.N);
    MwEq(ic) = Mw_of(Zeq, s, C);
    ev  = eig(jac(Zeq, C, P));
    ReL(ic) = max(real(ev));

    Tend = min(20000, max(2000, 15/abs(ReL(ic))));

    % IC
    ICs = cell(1,nIC);
    ICs{1} = Zeq .* (1 + 1e-4*randn(size(Zeq)));
    big = Zeq .* (1 + 0.5*(2*rand(size(Zeq)) - 1));
    while C - s*big <= 0                           % free monomer kept V > 0
        big = Zeq + 0.5*(big - Zeq);
    end
    ICs{2} = big;
    ICs{3} = z0_adim * C;

    rhs = @(t,Z) F_ode(Z,C,P.n1,P.n2,P.N,P.alpha,P.sigma,P.rho,P.omega, ...
                       P.beta,P.mu,P.lambda,P.gamma,P.tau,P.delta,P.k1);

    % transient, then uniformly sampled window
    for k = 1:nIC
        [~,Ya] = ode15s(rhs, [0 Tend-200], ICs{k}, opts);
        tw = linspace(Tend-200, Tend, 20001);
        [tw,Yw] = ode15s(rhs, tw, Ya(end,:).', opts);
        Yw = Yw.';
        W  = Yw(2,:);
        Mw = Mw_of(Yw, s, C);

        ampW(ic,k) = max(W) - min(W);
        ampM(ic,k) = max(Mw) - min(Mw);
        gap(ic,k)  = mean(Mw) - MwEq(ic); % uniform grid
        h = floor(numel(W)/2);
        drift(ic,k) = abs((max(W(h:end))-min(W(h:end))) - (max(W(1:h))-min(W(1:h)))) ...
                      / max(ampW(ic,k), eps);
        x  = W - mean(W);
        up = find(x(1:end-1) < 0 & x(2:end) >= 0);
        if numel(up) > 2, per(ic,k) = mean(diff(tw(up))); end

        fprintf('%7.4f  %+6.3f  %+.3e   %-12s  %.3e   %.3e   %7.4f   %+.3e   %.1e\n', ...
                C, dC(ic), ReL(ic), ICnames{k}, ampW(ic,k), ampM(ic,k), per(ic,k), gap(ic,k), drift(ic,k));
    end
end

%% CLASSIFICATION
fprintf('\nHopf frequency prediction: period at onset = 2*pi/omega_H = %.4f\n', 2*pi/omegaH);

below = dC < 0;
cycTol = 1e-6;
survive = any(ampW(below,:) > cycTol, 2);
if any(survive)
    fprintf('Cycle found BELOW C0_H at C0 = %s  -> SUBCRITICAL (bistable region).\n', ...
            mat2str(C0list(below(:) & [survive; false(nnz(~below),1)]),5));
else
    fprintf('No cycle below C0_H from any IC -> consistent with SUPERCRITICAL.\n');
end

% amplitude^2 ~ a (C0 - C0_H) near onset
near = dC > 0 & dC <= 0.20;
a2 = ampW(near,2).^2;
p  = polyfit(C0list(near).', a2, 1);
Cint = -p(2)/p(1);
R  = corrcoef(C0list(near), a2);
fprintf('Fit amp(W)^2 = a*C0 + b near onset: a = %.4e, extrapolated onset = %.5f (C0_H = %.5f), R^2 = %.5f\n', ...
        p(1), Cint, C0H, R(1,2)^2);
fprintf('  -> supercritical if R^2 ~ 1 and extrapolated onset ~ C0_H.\n');

%% FIGURES
figure;
subplot(2,2,1); hold on;
% amp = A (C0 - C0_H)^beta near onset
upFit = dC > 0 & dC <= 0.2;
x  = log(dC(upFit));  y = log(ampW(upFit,2)).';
[pf,S] = polyfit(x, y, 1);
Rinv = inv(S.R);  se = sqrt(diag(Rinv*Rinv') * S.normr^2 / S.df);
beta = pf(1);  A = exp(pf(2));
fprintf('Power-law fit: amp(W) = %.4f (C0 - C0_H)^%.4f  (+/- %.4f)\n', A, beta, se(1));

mk = {'bo','rs','g^'};
for k = 1:nIC
    plot(C0list, ampW(:,k), mk{k}, 'MarkerSize', 6, 'DisplayName', ICnames{k});
end
cFit = linspace(C0H, C0H + 0.2, 200);
cExt = linspace(C0H + 0.2, max(C0list), 200);
plot(cFit, A*(cFit - C0H).^beta, 'k-', 'LineWidth', 1.8, ...
     'DisplayName', sprintf('fit, \\beta = %.3f \\pm %.3f', beta, se(1)));
plot(cExt, A*(cExt - C0H).^beta, 'k--', 'LineWidth', 1.2, ...
     'DisplayName', 'fit extrapolated');
xline(C0H, 'k:', 'HandleVisibility', 'off');
xlabel('C_0'); ylabel('amplitude of W'); grid on;
legend('Location', 'northwest'); title('Cycle amplitude');

subplot(2,2,2); hold on;
plot(C0list(near), a2, 'rs', 'MarkerSize', 7);
cc = linspace(C0H, max(C0list(near)), 50);
plot(cc, polyval(p,cc), 'k-');
xline(C0H,'k--'); xlabel('C_0'); ylabel('amp(W)^2'); grid on;
title('Hopf scaling: amp^2 vs C_0');

subplot(2,2,3); hold on;
for k = 1:nIC, plot(C0list, gap(:,k), mk{k}, 'MarkerSize', 6); end
xline(C0H,'k--'); xlabel('C_0'); ylabel('\langle M_w\rangle_t - M_w^*'); grid on;
title('Gap between time-average and equilibrium');

subplot(2,2,4); hold on;
for k = 1:nIC, plot(C0list, per(:,k), mk{k}, 'MarkerSize', 6); end
yline(2*pi/omegaH,'k--'); xline(C0H,'k--');
xlabel('C_0'); ylabel('period'); grid on;
title('Period (dashed: 2\pi/\omega_H)');

%% Cycle amplitude
upFit = dC > 0 & dC <= 0.2;                       % points used for fit
x  = log(dC(upFit));  y = log(ampW(upFit,2)).';
[pf,S] = polyfit(x, y, 1);
Rinv = inv(S.R);  se = sqrt(diag(Rinv*Rinv') * S.normr^2 / S.df);
beta = pf(1);  A = exp(pf(2));                    % amp = A (C0 - C0_H)^beta

figure; hold on;
mk = {'bo','rs','g^'};
for k = 1:nIC
    plot(C0list, ampW(:,k), mk{k}, 'MarkerSize', 6, 'DisplayName', ICnames{k});
end

% fitted law
cFit = linspace(C0H, C0H + 0.2, 200);
cExt = linspace(C0H + 0.2, max(C0list), 200);
plot(cFit, A*(cFit - C0H).^beta, 'k-', 'LineWidth', 1.8, ...
     'DisplayName', sprintf('fit: %.3f (C_0 - C_0^H)^{%.3f \\pm %.3f}', A, beta, se(1)));
plot(cExt, A*(cExt - C0H).^beta, 'k--', 'LineWidth', 1.2, ...
     'DisplayName', 'fit extrapolated');

xline(C0H, 'k:', 'LineWidth', 1.2, 'DisplayName', 'C_0^H');
xlabel('C_0'); ylabel('amplitude of W');
title('Limit-cycle amplitude and power-law fit');
legend('Location', 'northwest'); grid on;

%% Functions
function m = Mw_of(Z, s, C0)
    m = 1 - s*Z/C0 + (s.^2)*Z/C0;
end

function J = jac(Zeq, C, P)
    rhs = @(Z) F_ode(Z,C,P.n1,P.n2,P.N,P.alpha,P.sigma,P.rho,P.omega, ...
                     P.beta,P.mu,P.lambda,P.gamma,P.tau,P.delta,P.k1);
    nz = numel(Zeq);  J = zeros(nz);
    for j = 1:nz
        h  = eps^(1/3)*max(abs(Zeq(j)),1e-10);
        Zp = Zeq; Zp(j) = Zp(j)+h;  Zm = Zeq; Zm(j) = Zm(j)-h;
        J(:,j) = (rhs(Zp)-rhs(Zm))/(2*h);
    end
end

function f = make_formulas(P)
    a=P.alpha; r=P.rho; om=P.omega; sg=P.sigma; be=P.beta; mu=P.mu;
    la=P.lambda; ga=P.gamma; ta=P.tau; de=P.delta; k1=P.k1;
    f.S  = @(W) (ga*W + la*W.^2) ./ (2*(mu + k1*W));
    X    = @(W) (4*be^3*f.S(W).^4) ./ (27*sg*(mu + k1*W).^2);
    up   = @(W) ((mu+k1*W)./(2*sg)) .* (1 + sqrt(1+X(W))) .* f.S(W);
    um   = @(W) ((mu+k1*W)./(2*sg)) .* (1 - sqrt(1+X(W))) .* f.S(W);
    f.T  = @(W) nthroot(up(W),3) + nthroot(um(W),3);
    A    = @(W) de*(a + ta*f.S(W) + r*f.T(W)) + ta*(om*f.T(W) + 3*la*W.^2);
    B    = @(W) 4*de*ta*(a + r*f.T(W)) .* (om*f.T(W) + 3*la*W.^2);
    V2   = @(W) (A(W)./(2*ta*(a + r*f.T(W)))) .* (1 - sqrt(1 - B(W)./A(W).^2));
    f.V  = @(W) sqrt(max(0, real(V2(W))));
    f.q  = @(W) ta*f.V(W).^2/de;
    f.mass = @(W) f.V(W) + P.nT*f.T(W) + P.n1*W + P.n2*f.S(W) ...
             + ((14*f.q(W) - 12*f.q(W).^2) ./ (1 - f.q(W)).^2) .* f.S(W);
end

function Wr = find_equilibria(C, f, nScan)
    fW = @(W) f.mass(W) - C;
    Wg = logspace(-25, log10(C/6), nScan);
    Fg = fW(Wg);
    ok = isfinite(Fg) & imag(Fg) == 0;  Fg = real(Fg);
    idx = find(ok(1:end-1) & ok(2:end) & Fg(1:end-1).*Fg(2:end) < 0);
    Wr = [];
    for r = 1:numel(idx)
        try
            w = fzero(@(x) real(fW(x)), [Wg(idx(r)), Wg(idx(r)+1)]);
            if isfinite(w) && w >= 0 && (isempty(Wr) || all(abs(Wr-w) > 1e-9*max(1,w)))
                Wr(end+1,1) = w;
            end
        catch
        end
    end
    Wr = sort(Wr);
end

function Z = build_eq(W, f, N)
    S = f.S(W);  q = f.q(W);
    Z = [f.T(W); W; S; S*q.^(1:N-1).'];
end

function Y = F_ode(Z, M, n1, n2, N, alpha, sigma, rho, omega, ...
                   beta, mu, lambda, gamma, tau, delta, k1)
    sizes_red = [2, n1, n2, n2 + 2*(1:N-1)];
    V = M - sizes_red*Z;
    Y = zeros(N+2,1);
    Y(1) = alpha*V^2 + rho*V^2*Z(1) - omega*Z(1) ...
         - n1*(beta*Z(3)^2*Z(1) + sigma*Z(1)^3) ...
         + delta*sum(Z(4:end)) + 3*gamma*Z(2);
    Y(2) = 2*mu*Z(3) + 2*k1*Z(2)*Z(3) - gamma*Z(2) - lambda*Z(2)^2;
    Y(3) = sigma*Z(1)^3 + beta*Z(3)^2*Z(1) - mu*Z(3) - k1*Z(2)*Z(3) ...
         - tau*V^2*Z(3) + delta*Z(4);
    for i = 4:N+1
        Y(i) = tau*V^2*Z(i-1) - delta*Z(i) - (tau*V^2*Z(i) - delta*Z(i+1));
    end
    Y(N+2) = tau*V^2*Z(N+1) - delta*Z(N+2);
end
