clear; clc;

% p = [alpha rho omega sigma beta mu lambda gamma tau delta k1 F1_p1 F1_p2 F1_p3 F1_p4]

p0 = [1e-2, 0.7, 0.1, 1e-4, 150, 0.01, 230, ...
      8, 0.8, 0.8, 250, ...
      5, 0.1, 0.1, 10];

param_names = ["alpha","rho","omega","sigma","beta","mu","lambda", ...
               "gamma","tau","delta","k1", ...
               "F1_p1","F1_p2","F1_p3","F1_p4"];

nParams = numel(p0);

C0_list = [8, 6, 4, 2, 1, 0.5, 0.41];
nC = numel(C0_list);

% SAMPLING

nSamples = 300;
lhs_raw = lhsdesign(nSamples, nParams);

% Bounds
lb = 0.5 * p0;
ub = 2.0 * p0;

P = lhs_raw .* (ub - lb) + lb;

Mw_final = zeros(nSamples,1);
Mw_max   = zeros(nSamples,1);
Mw_AUC   = zeros(nSamples,1);
Mw_tHalf = zeros(nSamples,1);


for i = 1:nSamples
    fprintf("Running sample %d/%d\n", i, nSamples);

    p = P(i,:);

    % 2 stages
    [t_common, Mw_all] = forward_Mw(p, C0_list);

    % All C0
    Mw_final_all = Mw_all(:, end);
    Mw_max_all   = max(Mw_all, [], 2);

    Mw_AUC_all   = zeros(nC,1);
    Mw_tHalf_all = zeros(nC,1);

    for c = 1:nC
        Mw_c = Mw_all(c,:);
        Mw_AUC_all(c) = trapz(t_common, Mw_c);

        half_val = 0.5 * Mw_max_all(c);
        idx = find(Mw_c >= half_val, 1, 'first');
        Mw_tHalf_all(c) = t_common(idx);
    end

    Mw_final(i) = mean(Mw_final_all);
    Mw_max(i)   = mean(Mw_max_all);
    Mw_AUC(i)   = mean(Mw_AUC_all);
    Mw_tHalf(i) = mean(Mw_tHalf_all);
end

%Global sensitivity SRC

X = (P - mean(P)) ./ std(P);
Y = (Mw_final - mean(Mw_final)) ./ std(Mw_final);

b = regress(Y, [X ones(nSamples,1)]);
SRC = abs(b(1:nParams));

%Global sensitivity PRCC

PRCC = zeros(1,nParams);
for j = 1:nParams
    others = setdiff(1:nParams, j);
    PRCC(j) = abs(partialcorr(P(:,j), Mw_final, P(:,others)));
end

%Results

[~, idx_SRC] = sort(SRC, 'descend');
[~, idx_PRCC] = sort(PRCC, 'descend');

fprintf("\n=== GLOBAL SENSITIVITY (SRC, ALL C0) ===\n");
for k = 1:nParams
    j = idx_SRC(k);
    fprintf("%2d. %-8s  SRC = %.4f\n", k, param_names(j), SRC(j));
end

fprintf("\n=== GLOBAL SENSITIVITY (PRCC, ALL C0) ===\n");
for k = 1:nParams
    j = idx_PRCC(k);
    fprintf("%2d. %-8s  PRCC = %.4f\n", k, param_names(j), PRCC(j));
end

function [t_common, Mw_all] = forward_Mw(p, C0_list)

    %% Unpack parameters
    alpha  = p(1);  rho    = p(2);  omega = p(3);  sigma = p(4);
    beta   = p(5);  mu     = p(6);  lambda= p(7);
    gamma  = p(8);  tau    = p(9);  delta = p(10); k1 = p(11);

    % Stage 1 parameters (previously hardcoded)
    pF1_1 = p(12);  pF1_2 = p(13);  pF1_3 = p(14);  pF1_4 = p(15);

    %% Model sizes
    nT=2; n1=6; n2=12; N=100;
    sizes=[1,nT,n1,n2+nT*(0:N-1)];

    %% Stage 1
    M = 100;
    Z0 = zeros(N+2,1);

    F1 = @(t,Z) F_ode(Z, M, n1, n2, N, ...
                      alpha, sigma, rho, omega, beta, mu, lambda, ...
                      pF1_1, pF1_2, pF1_3, pF1_4);

    [~,Y] = ode23s(F1, [0 300], Z0);
    Y = Y';

    z0 = Y(:,end)/M;
    z0(1)=0; z0(2)=0;

    M_agreg = sizes(2:end)*z0;
    z0_adim = z0 / M_agreg;

    %% Stage 2
    t_common = linspace(0,500,400);
    Mw_all = zeros(numel(C0_list), numel(t_common));

    for k = 1:numel(C0_list)
        C0 = C0_list(k);

        Z0_2 = z0_adim * C0;

        F2 = @(t,Z) F_ode(Z, C0, n1, n2, N, ...
                          alpha, sigma, rho, omega, beta, mu, lambda, ...
                          gamma, tau, delta, k1);

        [t_late, Y_late] = ode15s(F2, [0 500], Z0_2);
        Y_late = Y_late';

        Mw = compute_Mw(Y_late, C0, sizes);

        Mw_all(k,:) = interp1(t_late, Mw, t_common, 'pchip');
    end
end

function Mw = compute_Mw(Y, C0, sizes)
    nStates = size(Y,1);
    C_late = zeros(nStates+1, size(Y,2));
    C_late(2:end,:) = Y / C0;
    C_late(1,:) = 1 - sizes(2:end) * Y / C0;
    Mw = C_late(1,:) + sizes(2:end).^2 * Y / C0;
end
